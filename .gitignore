Set-Content .gitignore @"
# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
.env
*.log

# Editors/OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Build / dist
build/
dist/
*.spec

# Generated output (keys/certs/qr exports)
Production_data_*/
QR-Code/
keys_*/
certificates_*/
*.bin
*.png
*.svg

# Local config (keep example only)
config.yaml
"@
config.yaml
config.yaml
